    "philosophy": {
      "type": "rich-text",
      "blocks": {
        "philosophy_heading": {
          "type": "heading",
          "settings": {
            "heading": "Good bakes shouldn't need a disclaimer",
            "heading_size": "h1"
          }
        },
        "philosophy_text": {
          "type": "text",
          "settings": {
            "text": "<p>No palm oil. No trans fat. No artificial colours or flavours. Eggless where it counts. We would rather leave something out altogether than bury it in the small print.</p><p>Everything is baked in small batches, fresh each morning, and sent out across Tamil Nadu — because the kindest thing you can do to a good bake is get it to someone while it is still at its best.</p>"
          }
        },
        "philosophy_button": {
          "type": "button",
          "settings": {
            "button_label": "Shop the bakery",
            "button_link": "/collections/all",
            "button_style_secondary": false
          }
        }
      },
